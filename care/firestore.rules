rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 只有名單上的帳號可以讀寫（員工＋LINE 機器人）。
    // 光是「登入」不夠：Firebase 免費方案關不掉自行註冊，任何人都能用網頁上公開的金鑰註冊帳號，
    // 所以一定要用名單擋。新增員工帳號時，把 Email 加進下面的清單再發布。
    function isStaff() {
      return request.auth != null
        && request.auth.token.email in [
          'a0900038552@gmail.com',          // Mark
          'i0935349954@gmail.com',
          'i0935349455@gmail.com',
          'soso770724@gmail.com',           // 德賢店員工
          'linebot@grandmasterfix.com.tw'   // LINE 機器人（Apps Script）—— 不能拿掉，否則 LINE 登錄保固、預約、報價機器人都會失效
        ];
    }
    match /{document=**} {
      allow read, write: if isStaff();
    }
    // 官網中古機現貨頁（a0900038552-coder.github.io/used-phones）要讓客人不用登入就能讀「這一筆」。
    // 裡面只有客人本來就看得到的欄位（機型、售價、照片、驗機結果），不含成本、IMEI、最低價。
    // 只開「讀」，寫入一樣只有員工。
    match /settings/used_showcase {
      allow read: if true;
    }
    // 官網配件選購讀的公開清單（配件管理 care/acc.html 自動整理），一樣只開讀
    match /settings/acc_showcase {
      allow read: if true;
    }
  }
}
